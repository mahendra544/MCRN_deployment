# MCRN CLOUD DEPLOYMENT ENVIRONMENT
# Set these values in your cloud hosting provider. Do NOT commit real passwords/API keys.

# Public URL of the deployed MCRN website, without a trailing slash.
PUBLIC_APP_URL=https://YOUR-MCRN-DOMAIN.example

# The cloud platform provides PORT automatically. Leave it unset locally.
CLOUD_MODE=true

# =======================================================
# CENTRAL CLOUD POSTGRESQL (ONE SHARED DATABASE FOR MCRN)
# =======================================================
# All backends (auth, user, reporting, police, admin) connect to the SAME PostgreSQL database.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE

# Set to true if SSL is required by the cloud PostgreSQL provider (e.g., Supabase, Neon, AWS RDS, Render)
PG_SSL=true

# =======================================================
# AUTHENTICATION & SECURITY
# =======================================================
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_PLUS_CHARACTER_SECRET
JWT_EXPIRES_IN=1h
CORS_ORIGINS=*

# Auth SMTP (OTP and Account verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_USERNAME=YOUR_SMTP_GMAIL
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=MCRN Security <YOUR_SMTP_GMAIL>

# =======================================================
# ADMIN SECURITY & RESET
# =======================================================
ADMIN_DEFAULT_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
ADMIN_EMAILS=admin@example.com
RESET_SECRET=REPLACE_WITH_A_RANDOM_RESET_SECRET
SKIP_DB_INIT=false

# Admin SMTP (Password recovery / alerts)
EMAIL_USER=YOUR_ADMIN_SMTP_GMAIL
EMAIL_PASS=YOUR_ADMIN_GMAIL_APP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# =======================================================
# SUPABASE STORAGE
# =======================================================
# Required for missing-child report photos and police uploads.
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=missing-child-images

# =======================================================
# GATEWAY BACKEND SERVICE URLS (OPTIONAL OVERRIDES)
# =======================================================
# If services run on custom internal network addresses, configure them here:
# AUTH_BACKEND_URL=http://localhost:8080
# USER_BACKEND_URL=http://localhost:5001
# REPORTING_BACKEND_URL=http://localhost:5002
# POLICE_BACKEND_URL=http://localhost:5003
# ADMIN_BACKEND_URL=http://localhost:5004
