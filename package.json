{
  "name": "mcrn-monorepo",
  "version": "1.0.0",
  "description": "Missing Child Rescue Network (MCRN)",
  "workspaces": [
    "backend",
    "frontend",
    "integration/server"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "./setup.sh",
    "start": "./cloud-start.sh",
    "start:local": "./start.sh",
    "dev": "./start.sh",
    "check": "node -c backend/src/app.js && node -c backend/src/server.js && node -c api/index.js && cd frontend && npm run build",
    "init-db": "node database/scripts/init-db.js",
    "build": "cd frontend && npm run build",
    "test": "node tests/api-tests.js"
  }
}
