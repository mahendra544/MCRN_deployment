# ============================================================
# MCRN CENTRALIZED ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for your environment
# ============================================================

# DATABASE
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcrn
PG_SSL=false

# PORTS & NETWORKING
PORT=5000
API_GATEWAY_PORT=5000
INTEGRATION_PORT=5173
HOST=0.0.0.0
NODE_ENV=development

# AUTHENTICATION & SECURITY
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# EMAIL DELIVERY (Google Apps Script)
GOOGLE_APPS_SCRIPT_URL=
MCRN_SECRET=

# Safe email diagnostic: sends only to this explicitly configured recipient
# EMAIL_DIAGNOSTIC_RECIPIENT=your_test_inbox@gmail.com

# EMAIL ISOLATION & TEST RECIPIENT
# Set MCRN_DEV_OTP_MODE=true to isolate OTP delivery in testing/dev (never sends to fictional addresses)
MCRN_DEV_OTP_MODE=false
# Optional real inbox to receive redirected test OTPs during automated runs/development:
# TEST_EMAIL_RECIPIENT=your_test_inbox@gmail.com

# ADMIN PASSWORD-RESET EMAIL (Nodemailer SMTP; separate from Apps Script)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# POLICE NOTIFICATIONS
# Configured email address for police department alert notifications:
# POLICE_NOTIFICATION_EMAIL=police_alerts@your-domain.gov

# ADMIN CONFIGURATION
ADMIN_USERNAME=mcrn_admin
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password
ADMIN_EMAILS=admin@example.com,police_admin@example.com
RESET_SECRET=your_admin_reset_secret_here
PUBLIC_APP_URL=http://localhost:5000
CLOUD_MODE=false
SKIP_DB_INIT=false

# SUPABASE (MEDIA STORAGE)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=missing-child-images
