# ============================================================
# MCRN CENTRALIZED ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for your environment
# ============================================================

# DATABASE
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcrn
PG_SSL=false

# PORTS & NETWORKING
PORT=5000
API_GATEWAY_PORT=5000
INTEGRATION_PORT=5173
HOST=0.0.0.0
NODE_ENV=development

# AUTHENTICATION & SECURITY
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=1h
CORS_ORIGINS=*

# AUTH SMTP (OTP / VERIFICATION)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=MCRN Security <your_email@gmail.com>

# ADMIN CONFIGURATION
ADMIN_USERNAME=mcrn_admin
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password
ADMIN_EMAILS=admin@example.com,police_admin@example.com
RESET_SECRET=your_admin_reset_secret_here
PUBLIC_APP_URL=http://localhost:5000
CLOUD_MODE=false
SKIP_DB_INIT=false

# ADMIN SMTP
EMAIL_USER=your_admin_email@gmail.com
EMAIL_PASS=your_admin_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# SUPABASE (MEDIA STORAGE)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=missing-child-images
