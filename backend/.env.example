# Google Apps Script Web App email delivery
GOOGLE_APPS_SCRIPT_URL=
MCRN_SECRET=

# Optional: the safe email diagnostic sends only to this explicitly configured inbox.
# EMAIL_DIAGNOSTIC_RECIPIENT=your_test_inbox@gmail.com

# Admin password-reset emails use Nodemailer SMTP, not Google Apps Script.
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
